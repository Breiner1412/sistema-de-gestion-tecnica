# Producción: VM con Docker detrás de Caddy (ver README, "Despliegue").
# Copiar a .env y llenar lo marcado con <...>. Nunca subir el .env al repositorio.

APP_NAME="Sistema de Gestion Tecnica"
APP_ENV=production
# php artisan key:generate --show (o: docker compose run --rm soporte-app php artisan key:generate --show)
APP_KEY=<base64:...>
APP_DEBUG=false
APP_URL=https://<soporte.tudominio.com>
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

# IP fija de Caddy en la red "proxy" (ver README). Solo de ella se aceptan las
# cabeceras X-Forwarded-*.
TRUSTED_PROXIES=172.30.0.2

BCRYPT_ROUNDS=12

# Administrador inicial (se crea al sembrar). Clave de 12 caracteres o más.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=<admin@tudominio.com>
ADMIN_PASSWORD=<clave-larga-y-unica>

# Demo pública: true. Operación real: false.
DEMO_MODE=true
DEMO_PASSWORD=<clave-de-las-cuentas-demo>

# Al contenedor: a la salida estándar, que es donde docker logs las busca.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=soporte-mysql
DB_PORT=3306
DB_DATABASE=gestion_tecnica
DB_USERNAME=soporte
DB_PASSWORD=<clave-de-la-base>
DB_TIMEZONE=-05:00
# Solo para el contenedor soporte-mysql.
MYSQL_ROOT_PASSWORD=<clave-root-de-mysql>

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Base de datos para los tres: la app, la cola y el programador la comparten,
# y ahí viven también los bloqueos de withoutOverlapping().
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Con DEMO_MODE=true el correo se va al registro aunque esto diga smtp.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp.proveedor.com>
MAIL_PORT=587
MAIL_USERNAME=<usuario>
MAIL_PASSWORD=<clave>
MAIL_FROM_ADDRESS=<no-responder@tudominio.com>
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
PERFIL_CONSULTAS=false
